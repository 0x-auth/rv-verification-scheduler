#!/usr/bin/env python3
"""Kept for compatibility. Reads parse_core.py JSON on stdin, prints a verdict.
The logic now lives in rvsched/verilog.py (classify)."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from rvsched.verilog import classify  # noqa: E402


def recipe(name, decision, ext):
    tcl, sim = [], []
    if decision in ("FORMAL", "HYBRID_SPLIT"):
        tcl = [f"# Formal script for {name}", "clear -all",
               f"analyze -sv {name}.{ext}", f"elaborate -top {name}",
               "clock clk", "reset rst", "prove -all"]
    if decision in ("SIMULATION", "HYBRID_SPLIT"):
        sim = [f"# Sim compile for {name}", "vlib work",
               f"vlog +acc {name}.{ext}",
               f'vsim -c -do "run -all; quit" work.{name}_tb']
    return tcl, sim


def main(raw):
    try:
        m = json.loads(raw)
    except Exception as e:
        print(f"JSON parse error in ttc: {e}", file=sys.stderr)
        sys.exit(1)
    decision, conf, why = classify(m)
    name = m.get("module_name", "dut")
    ext = "sv" if (m.get("sv_interfaces") or m.get("sv_structs") or m.get("rvvi_hooks")) else "v"
    tcl, sim = recipe(name, decision, ext)
    keys = ("nonlinear_arith_ops", "nonlinear_detail", "sequential_state_bits",
            "max_datapath_width", "control_ops", "rvvi_hooks", "sva_assertions")
    print(json.dumps({
        "target_module": name, "recommended_engine": decision,
        "confidence": conf, "reasoning": why,
        "metrics_evaluated": {k: m.get(k, [] if k == "nonlinear_detail" else 0) for k in keys},
        "generated_eda_scripts": {"formal_tcl_commands": tcl,
                                  "simulation_compile_commands": sim},
    }, indent=4))


if __name__ == "__main__":
    main(sys.stdin.read())
